// Prisma Schema para Monitor de Servicios Web
// Base de datos MongoDB independiente y persistente

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String    @unique
  password  String
  role      String    @default("operador") // admin | operador | observador
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  color       String?  @default("blue") // blue | emerald | amber | purple | rose | cyan | indigo | slate
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Service {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  url              String
  category         String?    @default("General")
  status           String     @default("unknown") // up | down | degraded | unknown
  statusCode       Int?
  responseTime     Int? // en milisegundos
  checkInterval    Int        @default(60) // en segundos
  expectedStatus   Int        @default(200)
  timeout          Int        @default(10000) // en ms
  lastCheck        DateTime?
  lastStatusChange DateTime?
  lastError        String?
  uptimePercent    Float      @default(100.0)
  totalChecks      Int        @default(0)
  successfulChecks Int        @default(0)
  isActive         Boolean    @default(true)
  tags             String? // JSON o lista separada por comas

  // Chequeos avanzados y métricas
  checkType        String     @default("HTTP") // HTTP | TCP | SSL
  port             Int?       // Puerto para TCP o SSL personalizado
  httpMethod       String?    @default("GET") // GET | POST | HEAD
  headers          String?    // JSON con cabeceras HTTP personalizadas
  keyword          String?    // Palabra clave esperada en el cuerpo de respuesta
  sslDaysRemaining Int?       // Días restantes de validez SSL
  sslExpiryDate    DateTime?  // Fecha exacta de expiración SSL
  sslIssuer        String?    // Emisor del certificado SSL

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  logs CheckLog[]

  @@map("services")
}

model CheckLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceId    String   @db.ObjectId
  status       String // up | down | degraded
  statusCode   Int?
  responseTime Int? // en ms
  errorMessage String?
  checkType    String?  @default("HTTP")
  details      String?  // Detalles adicionales (SSL, keyword, etc.)
  createdAt    DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([createdAt])
  @@map("check_logs")
}

model PushSubscription {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  endpoint       String    @unique
  expirationTime Float?
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime  @default(now())

  @@map("push_subscriptions")
}

model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

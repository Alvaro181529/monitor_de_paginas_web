# Base de Datos Independiente con Prisma (SQLite autónomo o PostgreSQL/MySQL)
DATABASE_URL="file:./monitor.db"

# MongoDB (Opcional)
MONGO_URI="mongodb://localhost:27017/ohif-db"

# JWT Secret para sesiones y autenticación
JWT_SECRET="CAMBIAR_POR_UN_SECRETO_SEGURO_EN_PRODUCCION"

# Web Push VAPID Keys
# Generar nuevas con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="TU_CLAVE_PUBLICA_VAPID"
VAPID_PRIVATE_KEY="TU_CLAVE_PRIVADA_VAPID"
VAPID_SUBJECT="mailto:tu-correo@dominio.com"

# URL de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
